<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>我的个人网站</title>
    <style>
        body{
            background-color: #e6f4ff;
            font-family: system-ui; 
            text-align:center; 
            margin-top:60px;
        }
        /* 第一句绿色字体样式 */
        .name-text{
            color: #009933;
            font-size: 26px;
            font-weight: bold;
        }
        .welcome-text{
            font-size: 20px;
            color: #222;
        }
        .weather-box{
            width: 320px;
            margin: 20px auto;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 8px #ccc;
        }
    </style>
</head>
<body>
    <p class="name-text">hello I am Rain</p>
    <p class="welcome-text">欢迎回来</p>

    <!-- 大同天气模块 完整保留 -->
    <div class="weather-box">
        <iframe 
        src="https://tianqi.2345.com/weather/iframe/101100201" 
        width="100%" 
        height="130" 
        frameborder="0" 
        scrolling="no">
        </iframe>
    </div>

    <p>大同实时天气自动更新</p>
</body>
</html>
